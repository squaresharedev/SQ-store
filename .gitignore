# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# the E2E stack's own build dir (see distDir in next.config.ts)
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# cloudflare / opennext build output + local runtime vars
/.open-next/
/.wrangler/
.dev.vars
!.dev.vars.example
cloudflare-env.d.ts

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local run output. `next dev` and a full Playwright run each produce megabytes
# of it, and a captured log is a snapshot of one machine on one afternoon — it
# ages badly and reviews as noise.
/dev-server.log
/e2e-run.log

# env files — ignore real env files, but keep the committed examples.
# `.env.production` is a deliberate exception: it holds NEXT_PUBLIC_* values
# only (already public in wrangler.jsonc) and MUST be in the repo, because
# those are inlined at build time and a CI build without them ships a dead
# client bundle. Never put a secret in it.
.env
.env.*
!.env.example
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# e2e tooling (downloaded binaries)
/tools/

# test artifacts
/test-results/
/playwright-report/
