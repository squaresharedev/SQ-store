# ---------------------------------------------------------------------------
# COMMITTED build-time config for production builds (`next build`).
#
# NEXT_PUBLIC_* ONLY. Never add a secret here — this file is in git, and every
# value below is inlined verbatim into the JavaScript the browser downloads.
# Server-only secrets go to `wrangler secret put` / the Cloudflare dashboard.
#
# WHY THIS FILE EXISTS: NEXT_PUBLIC_* are baked into the client bundle at BUILD
# time. When CI built without them, `.open-next` shipped a bundle whose browser
# Supabase client had no URL or key, and every page died at the error boundary
# with "Supabase credentials missing" — the Worker vars in wrangler.jsonc could
# not rescue it, because they only reach the server at runtime. Keeping the
# public values in the repo means a build cannot silently lose them.
#
# These are the same values already committed in wrangler.jsonc, so this adds
# no exposure. `process.env` and `.env.local` both still win over this file
# (Next's load order), so CI secrets and local overrides keep working.
# ---------------------------------------------------------------------------

# Supabase project "SQ-store" (ref: vnyfndqpdllwhvhinjoi).
NEXT_PUBLIC_SUPABASE_URL="https://vnyfndqpdllwhvhinjoi.supabase.co"

# Publishable / anon key. Public by design: RLS is the access control.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZueWZuZHFwZGxsd2h2aGluam9pIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODMzMDExNTYsImV4cCI6MjA5ODg3NzE1Nn0.y_SUEDhSU6fmx2HU8r-DHe4XolwAo7JevqBTLtn6ebI"

# Public origin of the dashboard. Only used as the fallback for building email
# redirect links when a request carries no host header.
NEXT_PUBLIC_APP_URL="https://dashboard.squareshare.eu"

# Cloudflare Turnstile SITE key (bot check on sign-up and checkout). Public by
# design. It belongs HERE and not in wrangler.jsonc: the forms that render the
# widget are client components, so the key has to be in the bundle. Leave it
# unset until a widget exists for this zone; then add it here, deploy, and only
# after that set the secret on the Worker (`wrangler secret put
# TURNSTILE_SECRET_KEY`). The other way round, the server demands a token the
# browser was never asked for and every sign-up fails.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Buyer payments through Stripe Connect. "true" offers sellers a Stripe
# connection and, once theirs may take payments, their buyers a card checkout.
# Leave it unset until the Worker holds STRIPE_SECRET_KEY and
# STRIPE_CONNECT_WEBHOOK_SECRET and the rest of BUYER PAYMENTS in
# wrangler.jsonc is done: switched on alone it changes nothing a buyer sees,
# but the dashboard would offer a connection that cannot be made.
# NEXT_PUBLIC_STRIPE_CONNECT_ENABLED="true"

# The storefront embed's own origin: where a seller's snippet loads the
# loader from, and where its frame is served. Leave it unset until the
# hostname exists and routes to this Worker (STOREFRONT EMBED in
# wrangler.jsonc has the steps, in order). Unset, the embed is not offered:
# the snippet cannot be copied and nothing can be framed. Set before the
# hostname works, sellers would copy a snippet that shows nothing.
# NEXT_PUBLIC_EMBED_URL="https://embed.squareshare.eu"
