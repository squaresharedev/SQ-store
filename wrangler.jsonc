{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "squareshare-dashboard",
  "main": ".open-next/worker.js",
  // Store dashboard runs on the Cloudflare Workers *Node* runtime via OpenNext.
  // nodejs_compat is required by @opennextjs/cloudflare; the compatibility_date
  // must be >= 2024-09-23 for nodejs_compat to take effect.
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // NEXT_PUBLIC_* vars only — these ship to the browser bundle already, so
  // committing them here is no additional exposure. `wrangler deploy` treats
  // this object as authoritative and wipes any dashboard-added vars not
  // listed here, so this is also the fix for vars disappearing after deploy.
  // Secrets (SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY, R2 keys, etc.) do
  // NOT go here — set those with `wrangler secret put` / the CF dashboard.
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://vnyfndqpdllwhvhinjoi.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZueWZuZHFwZGxsd2h2aGluam9pIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODMzMDExNTYsImV4cCI6MjA5ODg3NzE1Nn0.y_SUEDhSU6fmx2HU8r-DHe4XolwAo7JevqBTLtn6ebI",
    "NEXT_PUBLIC_APP_URL": "https://dashboard.squareshare.eu",
    // Passkeys (lib/auth/passkeys.ts): the domain every passkey is bound to.
    // Public by nature (the browser shows it). The parent domain, so a
    // passkey survives a move between subdomains. NEVER CHANGE IT once
    // passkeys exist: every one registered would stop working. Its sealing
    // key is a secret: `wrangler secret put MFA_PASSKEY_KEY`.
    "WEBAUTHN_RP_ID": "squareshare.eu"
    // NEXT_PUBLIC_TURNSTILE_SITE_KEY: intentionally NOT set here yet. Add it
    // (plus `wrangler secret put TURNSTILE_SECRET_KEY`) once a Turnstile
    // widget exists in the Cloudflare dashboard for this zone — see
    // lib/turnstile.ts. Until then the sign-up bot check is off in
    // production, same as it is in local dev.
  },
  // Workers AI, used by lib/moderation to classify product images before they
  // reach R2. Binding it costs nothing on its own: the code only calls the
  // model when MODERATION_ENABLED=true, which is NOT set here on purpose (see
  // moderationEnabled() — the request shape is unverified until a deploy
  // proves it, so switching it on is a deliberate act, not a default).
  "ai": {
    "binding": "AI"
  }
  // CONTACT VERIFICATION: a code emailed or texted to the seller's buyer-facing
  // contact email and phone, typed back to prove they own them (see
  // lib/contact-verification). Mail and texts go out through Brevo's REST API
  // (lib/email/send.ts, lib/sms/send.ts), the same account and verified sender
  // domain that already relays Supabase Auth's mail.
  //
  // OFF until switched on, and switching it on is deliberate:
  //   Secrets (`wrangler secret put <NAME>`, never in this file):
  //     BREVO_API_KEY             a Brevo REST API key (xkeysib-...), NOT the
  //                               SMTP key the Auth relay uses
  //     CONTACT_VERIFICATION_KEY  32 random bytes, base64url: the HMAC key
  //                               codes are stored under. Rotating it only
  //                               voids codes in flight (15 minutes' worth).
  //   Email proof, vars:
  //     TRANSACTIONAL_EMAIL_FROM     a sender verified in Brevo
  //     TRANSACTIONAL_EMAIL_ENABLED  "true"
  //   Phone proof, vars (plus SMS credit on the Brevo account):
  //     SMS_SENDER   up to 11 letters/digits, e.g. "Squareshare"
  //     SMS_ENABLED  "true"
  //
  // Turning EMAIL on makes a proven contact email a condition of publishing,
  // for every seller (grandfathered proofs were cleared by
  // 20260926_contact_verification). With TRANSACTIONAL_EMAIL_* set but
  // CONTACT_VERIFICATION_KEY missing, nobody can publish and the logs say
  // why: a missing secret must never quietly switch the requirement off.
  // Phones are never required; an unproven one is simply not shown to buyers.
  //
  // SELLER PLANS (Stripe Billing on the platform account, lib/billing).
  // Every account is on Free until both secrets are set; with them, the
  // pricing modal's upgrades go live:
  //   Secrets (`wrangler secret put <NAME>`, never in this file):
  //     STRIPE_SECRET_KEY      a RESTRICTED key (rk_live_...): write Customers,
  //                            Checkout Sessions, Customer Portal, Subscriptions;
  //                            read Prices
  //     STRIPE_WEBHOOK_SECRET  signing secret of the endpoint at
  //                            https://<host>/api/billing/webhook
  // The Stripe side (Prices with the lookup keys in lib/billing/plans.ts,
  // Stripe Tax, the Customer Portal) is set up first; a price that does not
  // match plans.ts refuses checkout rather than charge it.
  //
  // Bindings (KV/R2/D1/Hyperdrive/secrets) get added here as the dashboard
  // grows. Secrets for the Workers runtime go in `.dev.vars` (local) and
  // `wrangler secret put` / the CF dashboard (production) — never in this file.
}
