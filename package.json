{
  "name": "squareshare-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/a11y",
    "seed": "node --env-file-if-exists=.env.local scripts/seed.ts",
    "reset-seed": "node --env-file-if-exists=.env.local scripts/reset-seed.ts",
    "reset-seeded-products": "node --env-file-if-exists=.env.local scripts/reset-seeded-products.ts",
    "build-catalog": "node scripts/build-catalog.ts",
    "mirror-catalog-images": "node --env-file-if-exists=.env.local scripts/mirror-catalog-images.ts",
    "check-catalog-images": "node scripts/check-catalog-images.ts",
    "stock-smoke": "node --env-file-if-exists=.env.local scripts/stock-smoke.ts",
    "check:migrations": "node --env-file-if-exists=.env.local scripts/check-prod-migrations.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "build:cf": "opennextjs-cloudflare build",
    "deploy": "wrangler deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.109.0",
    "aws4fetch": "^1.0.20",
    "clsx": "^2.1.1",
    "disposable-email-domains": "^1.0.62",
    "lucide-react": "^1.23.0",
    "motion": "^12.43.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "pg": "^8.22.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.105.0"
  }
}
