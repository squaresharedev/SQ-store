# Cloudflare static assets: headers for files served straight from the build.
#
# Every file gets the two transport headers the app's own responses carry
# (next.config.ts headers()): the Worker adds those to what it renders, but a
# file served straight from the build (sw.js, widget.js, every /_next/static
# chunk) never passes through it. KEEP THE VALUES EQUAL to next.config.ts;
# tests/unit/static-headers.test.ts compares them. A request matching several
# rules below gets the headers of all of them.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
#
# The font files may be read cross-origin. A storefront preview's MCP Apps view
# (lib/agent/preview/view.ts) draws this app's markup on the chat host's sandbox
# origin, and a browser fetches a cross-origin font only with CORS. Fonts are
# public build output, so any origin may have them.
/_next/static/media/*
  Access-Control-Allow-Origin: *

# Build output chunks carry a content hash in the filename, so they are safe
# to cache for a year. Without this rule, Cloudflare Static Assets serves them
# with `public, max-age=0, must-revalidate` by default, and every full page
# load (every buyer product page, every embed frame) revalidates every JS/CSS
# chunk. With the year cache, those files are fetched once and kept until the
# next deploy changes the hash.
#
# /sw.js is intentionally NOT listed here: the service worker spec requires it
# to be revalidated on every page load so the browser picks up updates.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The storefront embed loader. Sellers paste this URL into their own sites, so
# an hour of caching keeps load off the origin without delaying a widget fix
# by more than one hour. The file has no content hash in its name, so a year
# cache is not appropriate.
/widget.js
  Cache-Control: public, max-age=3600
