# ---------------------------------------------------------------------------
# Square Share — dashboard.squareshare.eu (creator dashboard)
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# gitignored; NEVER commit real keys.
# ---------------------------------------------------------------------------

# The store's own Supabase project ("SQ-store", ref: vnyfndqpdllwhvhinjoi).
# Safe to expose to the browser (NEXT_PUBLIC_*). The public production values
# live in the committed `.env.production`; copy those unless you are pointing
# local dev somewhere else.
NEXT_PUBLIC_SUPABASE_URL="https://vnyfndqpdllwhvhinjoi.supabase.co"

# Publishable / anon key (public, safe in the browser). Use the modern
# publishable key (sb_publishable_...) or the legacy anon JWT — either works.
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# Public origin of this app. Used as the fallback absolute URL for building
# email redirect links when no request host header is available. In prod,
# set to "https://dashboard.squareshare.eu".
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: the storefront embed's own origin (its loader script and its
# frame). Unset, development borrows NEXT_PUBLIC_APP_URL above, so the embed
# works locally with no second host: open /dev/embed-host on another name for
# this machine (http://shop.localhost:3000/dev/embed-host?key=<embed key>) to
# see it across two origins. In production it is the launch switch:
# "https://embed.squareshare.eu" once that hostname routes to the Worker.
# NEXT_PUBLIC_EMBED_URL=""

# Optional: override the auth-cookie domain. Leave unset to use the default
# (".squareshare.eu" in production, host-only in local dev).
# NEXT_PUBLIC_COOKIE_DOMAIN=".squareshare.eu"

# ---------------------------------------------------------------------------
# Stripe (payments/payouts). Get keys from the Stripe dashboard.
# The publishable key is safe in the browser; the secret and webhook signing
# keys are server-only and must never be prefixed with NEXT_PUBLIC_.
#
# Seller plans (lib/billing) use Stripe Billing on the PLATFORM account and go
# live when BOTH of these are set (lib/billing/availability.ts):
#   STRIPE_SECRET_KEY      a RESTRICTED key (rk_...) with write access to
#                          Customers, Checkout Sessions, Customer Portal and
#                          Subscriptions, and read access to Prices.
#   STRIPE_WEBHOOK_SECRET  the signing secret of the endpoint registered at
#                          /api/billing/webhook. Comma-separate two while
#                          rotating. Subscribe it to the events listed in
#                          HANDLED_EVENT_TYPES (lib/billing/webhook.ts).
# In the Customer Portal configuration, switch OFF "cancel subscription":
# cancelling happens in the app (cancelPlan), which asks why. Left on, the
# portal is a way out that skips the feedback.
# Production: `wrangler secret put` both. Test-mode keys locally, with
# `stripe listen --forward-to localhost:3000/api/billing/webhook`.
# BILLING_TEST_PROVIDER=1 instead fakes Stripe entirely (plans change the
# moment they are chosen); only under `next dev`, and it wins over real keys.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="paste-stripe-publishable-key-here"
# STRIPE_SECRET_KEY="paste-stripe-secret-key-here"
# STRIPE_WEBHOOK_SECRET="paste-stripe-webhook-signing-secret-here"
# BILLING_TEST_PROVIDER=1

# ---------------------------------------------------------------------------
# Hosted checkout.
# ORDER_LINK_SECRET keys the buyer's order links (lib/orders/order-link.ts),
# which are credentials: set it with `wrangler secret put ORDER_LINK_SECRET`.
# REQUIRED IN PRODUCTION: unset, no order link can be issued or accepted (the
# service role key stands in only outside production). Changing it retires every
# order link already emailed, so rotate deliberately.
# CHECKOUT_TEST_PAYMENTS=1 turns on the development test provider (orders are
# recorded with no money moving). It only works under `next dev`; a deployed
# build ignores it (lib/checkout/availability.ts).
# ---------------------------------------------------------------------------
# ORDER_LINK_SECRET="paste-a-long-random-string-here"
# CHECKOUT_TEST_PAYMENTS=1

# ---------------------------------------------------------------------------
# Buyer payments: Stripe Connect (lib/payments/connect). A buyer's payment is a
# direct charge on the SELLER's own connected Stripe account, with our cut as
# an application fee. Live when the switch is on AND both secrets are set
# (lib/payments/connect/config.ts); a real payment also needs order links, the
# bot check and mail (lib/checkout/availability.ts).
#   NEXT_PUBLIC_STRIPE_CONNECT_ENABLED  "true" switches the feature on. Read by
#                                       client components, so it is inlined at
#                                       BUILD time: in production it belongs in
#                                       .env.production.
#   STRIPE_SECRET_KEY                   the key above, with Connect access too.
#   STRIPE_CONNECT_WEBHOOK_SECRET       signing secret of the endpoint at
#                                       /api/payments/webhook, created to
#                                       listen to events on CONNECTED accounts
#                                       and subscribed to CONNECT_EVENT_TYPES
#                                       (lib/payments/connect/webhook.ts).
#   STRIPE_API_BASE                     development and tests only: where to
#                                       send Stripe API calls instead of
#                                       api.stripe.com. Ignored in a production
#                                       build. The Connect e2e run points it at
#                                       a stand-in (tests/e2e/stripe-mock.ts).
#   OPS_ALERT_EMAIL                     optional: where to mail the alerts
#                                       nobody using the app would report
#                                       (lib/ops/alert.ts). Always logged too.
# CHECKOUT_TEST_PAYMENTS wins over all of this under `next dev`.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_STRIPE_CONNECT_ENABLED="true"
# STRIPE_CONNECT_WEBHOOK_SECRET="paste-connect-webhook-signing-secret-here"
# OPS_ALERT_EMAIL="ops@example.com"

# ---------------------------------------------------------------------------
# Server errors (src/instrumentation.ts, lib/ops/report-error.ts). Every
# unhandled server error is logged as one JSON line behind "[server error]",
# always. Set ERROR_REPORT_URL to also POST that report to a collector (an
# error tracker's ingest endpoint, a chat webhook), with ERROR_REPORT_TOKEN as
# a bearer token if it wants one. The report names the route's pattern and the
# error, never the address, headers or body of the request. Both optional.
# ---------------------------------------------------------------------------
# ERROR_REPORT_URL="https://errors.example.com/ingest"
# ERROR_REPORT_TOKEN="paste-collector-token-here"

# ---------------------------------------------------------------------------
# Scheduled jobs (src/lib/ops/cron.ts). Routes under /api/cron/ answer only a
# caller holding CRON_SECRET, and answer 404 to everyone while it is unset, so
# nothing scheduled runs until it exists. Today that is one job: carrying out
# account deletions asked for in Settings, 14 days after the request
# (src/lib/account-deletion). 32 characters or more; set it on the Worker
# (`wrangler secret put CRON_SECRET`) AND as a repository secret, which is what
# .github/workflows/scheduled.yml calls the route with.
# ---------------------------------------------------------------------------
# CRON_SECRET="paste-a-long-random-string-here"

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (bot protection on sign-up). Off entirely — the widget
# doesn't render and the server doesn't check for one — unless BOTH vars below
# are set (see lib/turnstile.ts). Create a widget at Cloudflare dash > Turnstile
# to get real keys; the values below are Cloudflare's published "always passes"
# test pair, safe to use as-is for local dev (https://developers.cloudflare.com/turnstile/troubleshooting/testing/).
#
# IN PRODUCTION the two live in different places, and getting it wrong locks
# everyone out. The SITE key is read by client components, so it is inlined at
# BUILD time: it goes in the committed .env.production, not in wrangler.jsonc
# `vars` (those only reach the server at runtime). The SECRET goes on the
# Worker (`wrangler secret put TURNSTILE_SECRET_KEY`). Secret without a built-in
# site key = the server demands a token no browser was ever asked to solve, and
# every sign-up and every checkout fails. Ship the site key FIRST.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
# TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# ---------------------------------------------------------------------------
# SERVER-ONLY SECRETS — never prefix with NEXT_PUBLIC_ and never commit.
# ---------------------------------------------------------------------------
# Service role key (Supabase → Project Settings → API). Bypasses RLS. Required
# by the dev seed/reset scripts (scripts/seed.ts, scripts/reset-seed.ts) and any
# future server-side privileged calls. Server-side ONLY — never bundled.
# SUPABASE_SERVICE_ROLE_KEY="paste-service-role-secret-here"

# Direct Postgres connection URI (Supabase → Project Settings → Database →
# Connection string → URI). Contains the database password. Used ONLY by
# `pnpm check:migrations`, which reads supabase_migrations to confirm
# tests/db/prod-migrations.sql still matches production — that table is not
# reachable over PostgREST, so the anon/service keys cannot answer the question.
# Also the preferred way in for `pnpm check:schema` (the deploy gate, see
# scripts/lib/prod-schema.ts), which reads pg_catalog only: for that one a role
# that can log in and nothing else is enough, and is what CI should hold.
# SUPABASE_DB_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Supabase personal access token (Supabase → Account → Access Tokens). Full
# management access to the project, so it stays on a laptop and NEVER goes to
# CI or the Worker. Used by `pnpm check:schema` when SUPABASE_DB_URL is unset,
# and by scripts/auth-emails.ts to push the auth email templates.
# SUPABASE_ACCESS_TOKEN="sbp_..."

# Brevo SMTP credentials, read ONLY by scripts/auth-emails.ts to point Supabase
# Auth's own mail (confirm, reset, magic link) at Brevo. Not the REST key
# below, and never needed by the running app.
# BREVO_SMTP_USER="...@smtp-brevo.com"
# BREVO_SMTP_KEY="xsmtpsib-..."

# ---------------------------------------------------------------------------
# Passkeys and sign-in approval (lib/auth/passkeys.ts, passkey-crypto.ts).
#
# MFA_PASSKEY_KEY seals the server-held factor behind every passkey: 32 random
# bytes, base64url. WITHOUT IT PASSKEYS ARE UNAVAILABLE, and they are the
# two-factor method the app recommends. Generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# In production: `wrangler secret put MFA_PASSKEY_KEY`. Never rotate it once
# passkeys exist: every one registered would stop working.
#
# WEBAUTHN_RP_ID is the domain passkeys are bound to (default: the host of
# NEXT_PUBLIC_APP_URL). Production sets it to the parent domain in
# wrangler.jsonc. WEBAUTHN_ORIGINS adds extra accepted origins for the test
# stack on another port, and APPROVAL_ORIGIN points sign-in approval links at
# another https origin while developing; a production build ignores both.
# ---------------------------------------------------------------------------
# MFA_PASSKEY_KEY="<32 random bytes, base64url>"
# WEBAUTHN_RP_ID="localhost"
# WEBAUTHN_ORIGINS="http://localhost:3100"
# APPROVAL_ORIGIN="https://dashboard.squareshare.eu"

# ---------------------------------------------------------------------------
# Salts for the two one-way digests the app keeps instead of an IP address:
# unique visitors (lib/analytics/record.ts) and who filed a report
# (lib/moderation/reporter-hash.ts). Optional: each falls back to the
# service-role key. Set them in production anyway, because that key is rotated
# as a breach response, and rotating it then also resets every visitor count
# and lets the same person report the same thing twice.
# In production: `wrangler secret put <NAME>`.
# ---------------------------------------------------------------------------
# ANALYTICS_VISITOR_SALT="paste-a-long-random-string-here"
# MODERATION_REPORTER_SALT="paste-a-long-random-string-here"

# ---------------------------------------------------------------------------
# CONTENT MODERATION (lib/moderation/auto): the automatic check.
# ---------------------------------------------------------------------------
# Every product, storefront and marketplace item is hidden until its text,
# images and PDFs have been approved (migration 20261012_auto_moderation). The
# classifier is Claude; this is its key. In production:
# `wrangler secret put ANTHROPIC_API_KEY`.
#
# Without a key nothing can be approved: a save here stays "pending" until a
# deployment that has one sweeps it. That is deliberate (no answer is never an
# approval), and it is why local work normally uses the stand-in below.
# ANTHROPIC_API_KEY="sk-ant-..."
#
# Development builds only: answer in place of the classifier, from markers in
# the content ([[violation]], [[unsure]]; see lib/moderation/auto/
# test-provider.ts). The e2e stack sets it. Ignored by a production build.
# MODERATION_TEST_PROVIDER="1"

# ---------------------------------------------------------------------------
# DEV SEEDING (scripts/seed.ts + scripts/reset-seed.ts) — never set in prod.
# The scripts fail closed: they refuse to run unless SEED_ENV is exactly "dev".
# ---------------------------------------------------------------------------
# Opt-in flag. Set to "dev" ONLY on a disposable dev target you may seed/wipe.
# SEED_ENV="dev"

# Auth user id whose data the scripts create/delete. MUST be the account you
# sign in to /dashboard with (Supabase → Auth → Users → your user's UID),
# otherwise the dashboard (which shows the session user's rows) looks empty.
# TEST_SELLER_ID="00000000-0000-0000-0000-000000000000"

# Optional belt-and-suspenders: comma-separated Supabase project ref(s) the
# scripts are allowed to touch. If set, a mismatching project ref aborts the run.
# SEED_ALLOWED_PROJECT_REF="your-dev-project-ref"

# Cloudflare R2 (product uploads). Create an R2 API token in the Cloudflare
# dashboard (R2 > Manage API Tokens > Object Read & Write, scoped to the
# squareshare-products bucket). Account ID is on the dashboard sidebar.
R2_ACCOUNT_ID="32f68a5e041d51b08934ca72a42a2922"
R2_ACCESS_KEY_ID="paste-r2-access-key-id-here"
R2_SECRET_ACCESS_KEY="paste-r2-secret-access-key-here"
R2_BUCKET_NAME="squareshare-products"

# ---------------------------------------------------------------------------
# CONTACT VERIFICATION: proving a seller owns the email and phone buyers see.
#
# A code is emailed or texted to the stored value and typed back into the
# seller's own session (lib/contact-verification). Codes are stored as an HMAC
# under CONTACT_VERIFICATION_KEY: 32 random bytes, base64url. Generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# IN DEVELOPMENT nothing is ever sent: setting FROM (email) or SMS_SENDER
# (phone) plus the key is enough, and each message, code included, is PRINTED
# TO THE SERVER CONSOLE and kept at /dev/outbox. Gated on NODE_ENV=development,
# so it cannot happen in production.
#
# IN PRODUCTION the *_ENABLED flags and BREVO_API_KEY are required too; see
# wrangler.jsonc for the full list.
#
# LEFT UNSET = email proof is OFF: the publish gate still demands a contact
# email, just not a proven one (a gate demanding a code the platform cannot
# send is a locked door with no key). Phones can never be proven then, so
# none is shown to buyers.
# CONTACT_VERIFICATION_KEY="<32 random bytes, base64url>"
# TRANSACTIONAL_EMAIL_FROM="no-reply@squareshare.eu"
# TRANSACTIONAL_EMAIL_ENABLED="true"
# SMS_SENDER="Squareshare"
# SMS_ENABLED="true"
# BREVO_API_KEY="xkeysib-..."

# Moderation: tell the admin panel the moment a buyer files a report or a
# seller sends a paused item back for review, so staff get the push alert in
# seconds instead of at the admin's next once-a-minute scan. The ping carries
# no data (see lib/moderation/admin-ping.ts); the admin re-reads the database.
# SECRET must equal the admin panel's NOTIFY_SCAN_SECRET.
# LEFT UNSET = no ping; the scheduled scan still finds everything within a
# minute. On Cloudflare: wrangler secret put ADMIN_NOTIFY_SECRET
# ADMIN_NOTIFY_URL="https://admin.squareshare.eu"
# ADMIN_NOTIFY_SECRET=""

# ---------------------------------------------------------------------------
# Simulated Payments tab (Stripe Connect is not wired yet). Dev only: it shows
# invented balances, payouts and transactions. true = the healthy story; or name
# one: healthy, busy, new, action-needed, disconnected. With it on,
# /payments?mock=<name> switches story per request. /dev/payments shows all of
# them with no sign-in. See lib/payments/scenarios.ts.
# PAYMENTS_MOCK_DATA=true

# ---------------------------------------------------------------------------
# Storefront funnel (src/lib/analytics/funnel). Buyer funnel events are written
# to Workers Analytics Engine by the deployed Worker only: there is no local
# stand-in, so under `next dev` nothing is written and nothing fails. These two
# are what the daily rollup job reads Analytics Engine with (an account id, and
# an API token with Account Analytics Read and nothing else).
# LEFT UNSET = the job answers "configured": false.
# On Cloudflare: CLOUDFLARE_ACCOUNT_ID in wrangler.jsonc vars,
#                wrangler secret put FUNNEL_ANALYTICS_TOKEN
# CLOUDFLARE_ACCOUNT_ID=""
# FUNNEL_ANALYTICS_TOKEN=""
